    {
      "id": "move",
      "label": "Move",
      "enabledWhen": "normal"
    },
    {
      "id": "size",
      "label": "Size",
      "enabledWhen": "normal-and-resizable"
    },
    {
      "id": "minimize",
      "label": "Minimize",
      "enabledWhen": "not-minimized"
    },
    {
      "id": "maximize",
      "label": "Maximize",
      "enabledWhen": "normal-and-resizable"
    },
    {
      "id": "close",
      "label": "Close",
      "enabledWhen": "always"
    }
